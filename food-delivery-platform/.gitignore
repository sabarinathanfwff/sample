backend/.env
frontend/.env

# ---------------- Docker ----------------
.dockerignore
docker-compose.override.yml

# ---------------- Logs ----------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
backend/logs/
/var/log/*.log

# ---------------- OS / Editor ----------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ---------------- Runtime data ----------------
*.pid
*.seed
.cache/
.eslintcache

# ---------------- Local DB dumps ----------------
*.sql.gz
db-backups/
