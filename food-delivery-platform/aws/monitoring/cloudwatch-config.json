{
  "agent": {
    "metrics_collection_interval": 60,
    "run_as_user": "cwagent",
    "region": "us-east-1"
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/messages",
            "log_group_name": "/aws/ec2/{instance_id}/system",
            "log_stream_name": "messages",
            "retention_in_days": 30
          },
          {
            "file_path": "/var/log/docker",
            "log_group_name": "/aws/ec2/{instance_id}/docker",
            "log_stream_name": "docker",
            "retention_in_days": 30
          },
          {
            "file_path": "/var/lib/docker/containers/*/*.log",
            "log_group_name": "/aws/ec2/{instance_id}/containers",
            "log_stream_name": "{container_name}",
            "retention_in_days": 30
          },
          {
            "file_path": "/opt/food-delivery-platform/backend/logs/*.log",
            "log_group_name": "/aws/ec2/{instance_id}/backend",
            "log_stream_name": "backend",
            "retention_in_days": 30
          },
          {
            "file_path": "/var/log/nginx/access.log",
            "log_group_name": "/aws/ec2/{instance_id}/frontend",
            "log_stream_name": "nginx-access",
            "retention_in_days": 30
          },
          {
            "file_path": "/var/log/nginx/error.log",
            "log_group_name": "/aws/ec2/{instance_id}/frontend",
            "log_stream_name": "nginx-error",
            "retention_in_days": 30
          }
        ]
      }
    },
    "log_stream_name": "{instance_id}"
  },
  "metrics": {
    "metrics_collected": {
      "cpu": {
        "measurement": [
          "cpu_usage_idle",
          "cpu_usage_iowait",
          "cpu_usage_user",
          "cpu_usage_system"
        ],
        "metrics_collection_interval": 60,
        "resources": ["*"],
        "append_dimensions": {
          "InstanceId": "${aws:InstanceId}"
        }
      },
      "disk": {
        "measurement": [
          "used_percent",
          "free",
          "total"
        ],
        "metrics_collection_interval": 60,
        "resources": ["/"],
        "append_dimensions": {
          "InstanceId": "${aws:InstanceId}"
        }
      },
      "diskio": {
        "measurement": [
          "read_bytes",
          "write_bytes",
          "reads",
          "writes"
        ],
        "metrics_collection_interval": 60,
        "resources": ["*"]
      },
      "mem": {
        "measurement": [
          "mem_used_percent",
          "mem_available",
          "mem_total"
        ],
        "metrics_collection_interval": 60,
        "append_dimensions": {
          "InstanceId": "${aws:InstanceId}"
        }
      },
      "net": {
        "measurement": [
          "bytes_sent",
          "bytes_recv",
          "packets_sent",
          "packets_recv"
        ],
        "metrics_collection_interval": 60,
        "resources": ["*"],
        "append_dimensions": {
          "InstanceId": "${aws:InstanceId}"
        }
      },
      "swap": {
        "measurement": [
          "swap_used_percent"
        ],
        "metrics_collection_interval": 60
      }
    },
    "append_dimensions": {
      "AutoScalingGroupName": "${aws:AutoScalingGroupName}",
      "ImageId": "${aws:ImageId}",
      "InstanceId": "${aws:InstanceId}",
      "InstanceType": "${aws:InstanceType}"
    },
    "force_flush_interval": 60
  }
}
