# =============================================================
# .env.example - AI-Powered Food Delivery Platform
# -------------------------------------------------------------
# Copy to .env and fill in real values. NEVER commit the real .env.
# =============================================================

# ---------------- Backend (Node.js / Express) ----------------
# Server
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=food_delivery
DB_USER=food_delivery_app
DB_PASSWORD=changeme_strong_password
# Convenience connection string (used if provided).
DATABASE_URL=postgresql://food_delivery_app:changeme_strong_password@localhost:5432/food_delivery

# Redis (caching / sessions / queues)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# Security / Auth
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=replace_with_another_random_secret
BCRYPT_ROUNDS=12
SESSION_SECRET=replace_with_session_secret

# AI / ML Services
OPENAI_API_KEY=
AI_RECOMMENDATION_MODEL=gpt-4
CHATBOT_ENABLED=true

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_GATEWAY=stripe

# Email / Notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=no-reply@fooddelivery.com

# File storage (S3)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_REGION=us-east-1

# CORS
CORS_ORIGIN=http://localhost:3000

# ---------------- Frontend (React) ----------------
# Base URL of the backend API. Used at build & runtime.
VITE_API_URL=http://localhost:5000/api
VITE_APP_NAME=FoodDelivery
VITE_GOOGLE_MAPS_API_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_S3_BUCKET_URL=
# Set to the public app domain in production.
VITE_APP_URL=http://localhost:3000
