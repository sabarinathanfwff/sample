# =============================================================
# Dockerfile.frontend - AI-Powered Food Delivery Platform
# -------------------------------------------------------------
# Multi-stage build for the React single-page application.
#
# Stage 1 (build):  install deps and build the static bundle
#                   with Vite / CRA / Webpack.
# Stage 2 (serve):  lightweight Nginx Alpine image that serves
#                   the compiled assets and proxies /api to the
#                   backend container.
#
# Build:
#   docker build -f docker/Dockerfile.frontend \
#     --build-arg VITE_API_URL=http://localhost:5000/api \
#     -t fdp-frontend:latest .
# =============================================================

# ---------------- Stage 1: build ----------------
FROM node:18-alpine AS build
WORKDIR /app

RUN apk add --no-cache python3 make g++

COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci || npm install

COPY frontend/ ./

# Inject the backend API location at build time.
ARG VITE_API_URL=http://localhost:5000/api
ENV VITE_API_URL=${VITE_API_URL}

# Build the production bundle into /app/dist (Vite) or /app/build (CRA).
RUN npm run build

# ---------------- Stage 2: serve ----------------
FROM nginx:1.27-alpine AS runtime

# Remove the default Nginx config and add our own (see below).
RUN rm /etc/nginx/conf.d/default.conf
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

# Copy compiled assets from the build stage.
COPY --from=build /app/dist /usr/share/nginx/html
# For Create React App, use: COPY --from=build /app/build /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost/healthz || exit 1

CMD ["nginx", "-g", "daemon off;"]
