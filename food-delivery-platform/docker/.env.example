# =============================================================
# docker/.env.example - Docker Compose environment
# -------------------------------------------------------------
# Copy to docker/.env and adjust. Loaded by docker-compose.yml.
# =============================================================

# ---------------- Environment ----------------
NODE_ENV=development

# ---------------- PostgreSQL ----------------
POSTGRES_DB=food_delivery
POSTGRES_USER=food_delivery_app
POSTGRES_PASSWORD=changeme_strong_password

# ---------------- Redis ----------------
REDIS_PASSWORD=

# ---------------- Frontend (build-time) ----------------
VITE_API_URL=http://localhost:5000/api

# ---------------- Host ports (optional override) ----------------
# FRONTEND_HOST_PORT=3000
# BACKEND_HOST_PORT=5000
# POSTGRES_HOST_PORT=5432
